# 서버 전용 — NEXT_PUBLIC_ 접두사 금지 (키를 클라이언트에 노출하지 않는다)

# ListeningMind DaaS API (lib/daas.ts)
LM_API_BASE=https://listeningmind-data-api.ascentlab.io
LM_API_KEY=your-daas-api-key-here

# Claude API — 실시간 KBF 분류용 (lib/llm.ts)
# 설계 결정(§8 결정 5): playbook 전용 신규 키를 발급해 쓴다. lima-agents Claude Desktop 세션이나
# 다른 앱(web/, market-intel-web/)의 키와 공유하지 않는다.
ANTHROPIC_API_KEY=your-playbook-only-anthropic-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-6

# 잡 상태 저장 — Vercel Marketplace의 Redis(Upstash) 연동을 프로젝트에 붙이면 자동 주입됨 (lib/store.ts)
# 로컬에서 비워두면 프로젝트 루트 .data/kv/ 에 파일로 대체 저장됨(개발 전용, git 추적 안 함)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 완성 리포트 JSON 저장 — Vercel Blob 연동을 붙이면 자동 주입됨 (lib/store.ts)
# 로컬에서 비워두면 프로젝트 루트 .data/blob/ 에 파일로 대체 저장됨(개발 전용, git 추적 안 함)
BLOB_READ_WRITE_TOKEN=
